{
  "name": "@avrilfanomar/orrery-core",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "The pure domain of Orrery: node graph, append-only events, projection, evaluation and rollup",
  "keywords": [
    "requirements",
    "kpi",
    "event-sourcing",
    "quality"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avrilfanomar/orrery.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/avrilfanomar/orrery/tree/main/packages/core#readme",
  "engines": {
    "node": ">=20.19"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build && node -e \"fs.copyFileSync('../../LICENSE','LICENSE')\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.12",
    "vitest": "^4.1.12"
  }
}

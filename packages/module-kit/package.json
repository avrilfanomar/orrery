{
  "name": "@avrilfanomar/orrery-module-kit",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "The contract an Orrery module implements: query languages and the source kinds the server can pull from",
  "keywords": [
    "orrery",
    "module",
    "metrics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avrilfanomar/orrery.git",
    "directory": "packages/module-kit"
  },
  "homepage": "https://github.com/avrilfanomar/orrery/tree/main/packages/module-kit#readme",
  "engines": {
    "node": ">=20.19"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build && node -e \"fs.copyFileSync('../../LICENSE','LICENSE')\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}

[
  {
    "id": "prometheus",
    "kind": "prometheus",
    "url": "http://127.0.0.1:9090",
    "publicUrl": "http://localhost:9090",
    "stepSeconds": 300
  },
  {
    "id": "grafana",
    "kind": "prometheus",
    "url": "http://127.0.0.1:3000",
    "grafana": { "datasourceUid": "replace-with-your-prometheus-datasource-uid" },
    "tokenEnv": "RU_GRAFANA_TOKEN",
    "publicUrl": "http://localhost:3000",
    "stepSeconds": 300
  }
]
